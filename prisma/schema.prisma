generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String  @id @default(cuid())
  name       String
  email      String  @unique
  password   String
  avatar     String?
  isVerified Boolean

  Transaction Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  stock       Int?
  name        String
  price       Float
  description String?
  image       String[]
  merchantId  String?

  Transaction Transaction[]
  Merchant    Merchant?     @relation(fields: [merchantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoryId  String?
  Category    Category?      @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TransactionStatus {
  capture
  settlement
  pending
  deny
  cancel
  expire
  failure
  refund
  partial_refund
  authorize
}

enum FraudStatus {
  accept
  deny
}

enum CategoryType {
  BOOKS
  SPORTS
}

model Transaction {
  id                 String             @id @default(cuid())
  order_id           String             @unique
  quantity           Int?
  userId             String
  productId          String
  transaction_status TransactionStatus?
  gross_amount       Int
  paymentMethod      String
  paymentType        String?
  fraudStatus        FraudStatus?
  transactionTime    DateTime? // waktu transaksi dari Midtrans
  paymentUrl         String?
  status_message     String?
  signature_key      String?
  logMessage         String?

  expiry_time String?

  User           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  Product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  CounterPayment CounterPayment?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      CategoryType
  Product Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model CounterPayment {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  store         String
}

model Merchant {
  id          String  @id @default(cuid())
  name        String
  description String?
  avatar      String?
  email       String  @unique
  password    String
  isVerified  Boolean

  Product Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
